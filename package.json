{
  "name": "chatbot-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Customer advisor agent for a fictional car service company: Claude tool use, mock calendar, guardrails.",
  "scripts": {
    "dev": "wrangler pages dev public --port 8788",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "check": "npm run typecheck && npm test",
    "deploy": "wrangler pages deploy public --project-name chatbot-demo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.148.0"
  }
}
