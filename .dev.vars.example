# Copy to .dev.vars for local development. Never commit .dev.vars.
ANTHROPIC_API_KEY=sk-ant-...
# Salt for hashing visitor IPs in rate-limit counters. Any random string.
RATE_SALT=change-me
# Set to 1 to run the UI against a scripted fake model (no API calls, no cost).
CHAT_FAKE=0
# Message caps per visitor and for the whole demo per day (defaults 6 and 50).
# Raise the visitor cap for local work; production keeps the defaults.
RATE_PER_VISITOR=100
RATE_PER_DAY=500
